
from tkinter import messagebox, simpledialog, Tk
import random

class Room:
    def __init__(self, time, cost, name):
        self.time = time
        self.cost = cost
        self.name = name
    def is_avaliable(self):
        if self.time != 0:
            return False
        return True

#class DeluxeRoom(Room):
    #def __init__(self, time, cost, name):
        #self.time = time
        #self.cost = cost*2
        #self.name = name
        
rooms = [Room(0, 100, "") for i in range (100)]

game = True

while game == True:

    randNum = random.randint(0, 3)

    print("Number is " + str(randNum) + ". If 0, card is declined.")

    cost = 0
    original = simpledialog.askstring(None, "Welcome to The League Hotel. Would you like to check someone in or out?")

    if original == "in":
        name = simpledialog.askstring(None, "What is your name?")
        time = simpledialog.askstring(None, "How many nights would you like to stay for?")
        check_in1 = simpledialog.askstring(None, "What floor would you like to be on? We have 3 floors.")
        if check_in1 == "1":
            cost += 50
        if check_in1 == "2":
            cost += 100
        if check_in1 == "3":
            cost += 150

        roomnumber = -1
        for i in range(len(rooms)):
            if rooms[i].is_avaliable():
                roomnumber = i 
                
                break
            #if rooms [i] == check_in1:
                #if len(rooms [i]) == 0:
                    #roomnumber = i
                    #break
        if roomnumber < 0:
            messagebox.showerror(message="There are no rooms of that type avalible")

        if roomnumber > -1:
            messagebox.showinfo(message="You will be in room " + str(roomnumber))
            rooms[roomnumber].reserve(name,time)
            rooms [roomnumber].name = name
            rooms [roomnumber].cost = cost
            rooms [roomnumber].time = time

    discount = simpledialog.askstring(None, "Do you have a membership?")

    if discount == "no":
        purchase = simpledialog.askstring(None, "Would you like to buy a membership card? It would only cost $15, and it would get you 10% off!")
        if purchase == "yes":
            cost = cost-(cost/10)
            cost += 15
        check_in4 = simpledialog.askstring(None, "That will cost $" + str(cost) + " for " + time + " nights on floor " + check_in1 + ", with no membership card. Will you pay with Cash or Card?")

    if discount == "yes":
        level = simpledialog.askstring(None, "Do you have a Basic, Silver, Gold, or Platinum membership card?")
        if level == "basic":
            cost = cost-(cost/10)
            simpledialog.askstring(None, "That gets you 10% off.")
        elif level == "silver":
            cost = cost-(cost/5)
            simpledialog.askstring(None, "That gets you 20% off.")
        elif level == "gold":
            cost = cost-(cost/4)
            simpledialog.askstring(None, "That gets you 25% off.")
        elif level == "platinum":
            cost = cost/2
            simpledialog.askstring(None, "That gets you 50% off.")
        check_in4 = simpledialog.askstring(None, "That will cost $" + str(cost) + " for " + time + " nights on floor " + check_in1 + ", with a " + level + " membership card. Will you pay with Cash or Card?")     
    
    if check_in4 == "card":
        cardnum = simpledialog.askinteger(None, "What is your credit card number?")
        if randNum == 0:
            messagebox.showerror(message="Your Credit Card has been declined. Please try again.")
            decline = "was"
        else:
            messagebox.showinfo(message="You have paid. Thank you for staying at The League Hotel!")
            decline = "was not"
        print("Card number is " + str(cardnum) + ". Card " + decline + " declined.")
    else:
        messagebox.showinfo(message="You have paid. Thank you for staying at The League Hotel!")
        #messagebox.showinfo(message="Thank you for staying at The League Hotel!")
        #print(reservation)

    print("Name is " + name + ". Staying for " + str(time) + " nights on floor " + str(check_in1) + ". Paid $" + str(cost) + " with " + check_in4 + ".")
    
    day = simpledialog.askstring(None, "Has one day passed?")
    if day == "yes":
        time = time-1
    if time == 0:
        simpledialog.askstring(None, "Someone is ready to check out!")

    exit = simpledialog.askstring(None, "Would you like to sign out?")
    if exit == "yes":
        game = False